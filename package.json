{
  "name": "job-application-agent-kit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "auth": "tsx src/index.ts auth",
    "apply": "tsx src/index.ts apply",
    "search": "tsx src/index.ts search",
    "ui": "tsx src/workbench-server.ts",
    "check": "tsc --noEmit",
    "check:python": "python3 scripts/check_python_helpers.py",
    "tracker:audit": "python3 scripts/audit_application_tracker.py",
    "tracker:audit:fix": "python3 scripts/audit_application_tracker.py --fix",
    "tracker:archive-incomplete": "python3 scripts/archive_incomplete_applications.py --apply",
    "tracker:migrate-report-evidence": "python3 scripts/migrate_application_report_evidence.py --apply",
    "tracker:sync-email": "python3 scripts/sync_email_application_outcomes.py",
    "test": "node --import tsx --test tests/*.test.ts",
    "ci": "npm run check && npm run check:python && npm test"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "playwright": "^1.55.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
